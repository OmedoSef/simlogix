#!/usr/bin/env bash
# Runs formatting/lint checks before a commit is created.
# See documentation/contributing/code-conventions.md.
set -euo pipefail

echo "pre-commit: cargo fmt --check"
if ! cargo fmt --all -- --check; then
    echo "error: formatting issues found — run 'cargo fmt' and re-stage" >&2
    exit 1
fi

echo "pre-commit: cargo clippy"
cargo clippy --workspace --all-targets
